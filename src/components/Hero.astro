---
import Button from './Button.astro';
import { landing } from '../content/landing';

const { brand, tagline, cta, hero } = landing;
---

<!--
  Mobile: title, lead and quotes sit mid-screen, the button sticks to the bottom.
  Desktop: title mid-screen, lead · quotes · button in a 3-column row at the bottom.
  Both are done with auto margins on top of a minimum gap; the row wrapper is
  `contents` on mobile. Columns never squeeze the button below its content.
-->
<section
  aria-labelledby="hero-title"
  class="mx-auto flex min-h-svh max-w-page flex-col gap-7 px-6 pt-5 pb-8 lg:px-20 lg:pt-8 lg:pb-16"
>
  <header class="flex h-11 items-center justify-between lg:h-12">
    <p class="font-display text-logo font-bold">{brand}</p>
    <p class="text-label font-medium">{tagline}</p>
  </header>

  <h1 id="hero-title" class="mt-auto max-w-hero-title font-display text-h1 font-bold">
    {hero.title} <span class="block text-signal">{hero.titleAccent}</span>
  </h1>

  <div class="contents lg:mt-auto lg:grid lg:grid-cols-[repeat(3,1fr)] lg:items-end lg:gap-12 lg:border-t-strong lg:pt-8">
    <p class="max-w-hero-lead text-hero-lead">{hero.lead}</p>

    <div class="flex flex-col gap-2.5 border-t-strong pt-5 lg:border-t-0 lg:pt-0">
      <p class="text-quote-old line-through decoration-(length:--border-width-strong)">{hero.quoteBefore}</p>
      <p class="text-quote font-semibold">{hero.quoteAfter}</p>
    </div>

    <Button variant="dark" cta="hero" class="mt-auto lg:mt-0">{cta}</Button>
  </div>
</section>
