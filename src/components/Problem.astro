---
import SectionLabel from './SectionLabel.astro';
import { landing } from '../content/landing';

const { problem } = landing;
---

<section aria-labelledby="problem-label" class="bg-sand">
  <div
    class="mx-auto flex max-w-page flex-col gap-9 px-6 py-18 lg:grid lg:grid-cols-12 lg:gap-x-8 lg:gap-y-16 lg:px-20 lg:py-30"
  >
    <SectionLabel id="problem-label" class="lg:col-span-3">{problem.label}</SectionLabel>

    <div class="flex flex-col gap-3.5 lg:col-span-9 lg:gap-5">
      <h2 class="font-display text-mega font-bold whitespace-nowrap">{problem.figure}</h2>
      <p class="max-w-lead text-lead font-medium">{problem.lead}</p>
    </div>

    <div class="flex flex-col gap-3 border-y py-5 lg:col-span-4 lg:col-start-4 lg:border-b-0 lg:pt-6 lg:pb-0">
      <p class="text-dialog font-semibold">{problem.dialog.line}</p>
      <p class="text-dialog-body">{problem.dialog.text}</p>
    </div>

    <div class="flex flex-col gap-2.5 lg:col-span-4 lg:col-start-9 lg:gap-3 lg:border-t lg:pt-6">
      <p class="font-display text-insight font-medium">{problem.insight.title}</p>
      <p class="text-insight-body">{problem.insight.text}</p>
    </div>
  </div>
</section>
