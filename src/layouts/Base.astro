---
import '../styles/global.css';
import unboundedCyrillic from '@fontsource-variable/unbounded/files/unbounded-cyrillic-wght-normal.woff2?url';
import onestCyrillic from '@fontsource-variable/onest/files/onest-cyrillic-wght-normal.woff2?url';
import { landing } from '../content/landing';

const { title, description } = landing.meta;
// Above-the-fold text is Cyrillic: load these fonts before CSS discovers them
const fontPreloads = [unboundedCyrillic, onestCyrillic];
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Same as --color-paper -->
    <meta name="theme-color" content="#F1EEE7" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {fontPreloads.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/og.png" />
  </head>
  <body>
    <slot />
  </body>
</html>
